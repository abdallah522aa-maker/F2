local function checkAndSendHeartbeat()
    if not httpReq then return end
    pcall(function()
        local checkRes = httpReq({
            Url = FIREBASE_URL .. "/kicks/" .. userId .. ".json",
            Method = "GET"
        })

        if checkRes and checkRes.Body and checkRes.Body ~= "null" and checkRes.Body ~= "" then
            local success, kickData = pcall(function() return HttpService:JSONDecode(checkRes.Body) end)
            if success and kickData then
                httpReq({
                    Url = FIREBASE_URL .. "/kicks/" .. userId .. ".json",
                    Method = "DELETE"
                })
                task.wait(0.2)
                LocalPlayer:Kick("Shutdown")
                return
            end
        end

        local tpRes = httpReq({
            Url = FIREBASE_URL .. "/teleports/" .. userId .. ".json",
            Method = "GET"
        })
        
        if tpRes and tpRes.Body and tpRes.Body ~= "null" and tpRes.Body ~= "" then
            local success, tpData = pcall(function() return HttpService:JSONDecode(tpRes.Body) end)
            if success and tpData and tpData.job_id then
                httpReq({
                    Url = FIREBASE_URL .. "/teleports/" .. userId .. ".json",
                    Method = "DELETE"
                })
                task.wait(0.2)
                TeleportService:TeleportToPlaceInstance(tpData.place_id or game.PlaceId, tpData.job_id, LocalPlayer)
            end
        end

        httpReq({
            Url = FIREBASE_URL .. "/users/" .. userId .. ".json",
            Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                username = LocalPlayer.Name,
                display_name = LocalPlayer.DisplayName,
                job_id = game.JobId,
                last_seen = os.time()
            })
        })
    end)
end

task.spawn(function()
