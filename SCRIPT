local function sendRemoteArgs(args, isPublicMode)
    if isPublicMode then
        local remote1
        pcall(function()
            remote1 = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("DataService")
        end)

        if remote1 then
            pcall(function()
                remote1:FireServer(unpack(args))
            end)
        end

        pcall(function()
            local remote2 = ReplicatedStorage:FindFirstChild("HDAdminHDClient") and ReplicatedStorage.HDAdminHDClient:FindFirstChild("Signals") and ReplicatedStorage.HDAdminHDClient.Signals:FindFirstChild("RequestCommandModification")
            if remote2 then remote2:InvokeServer(unpack(args)) end
        end)
    else
        pcall(function()
            local remote2 = ReplicatedStorage:FindFirstChild("HDAdminHDClient") and ReplicatedStorage.HDAdminHDClient:FindFirstChild("Signals") and ReplicatedStorage.HDAdminHDClient.Signals:FindFirstChild("RequestCommandModification")
            if remote2 then remote2:InvokeServer(unpack(args)) end
        end)
    end
end

